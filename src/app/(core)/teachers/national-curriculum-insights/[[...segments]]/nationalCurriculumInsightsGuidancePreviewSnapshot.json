    {
      "__typename": "NationalCurriculumInsightsFaqSection",
      "heading": "Frequently Asked Questions",
      "items": [
        {
          "question": "Do I need to rewrite my curriculum now?",
          "answerPortableText": [
            {
              "_key": "guidance-faq-1-answer",
              "_type": "block",
              "children": [
                {
                  "_key": "guidance-faq-1-answer-span",
                  "_type": "span",
                  "marks": [],
                  "text": "No. Keep using your current curriculum while the refreshed national curriculum is finalised. We will update this guidance as the detail is confirmed."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ]
        },
        {
          "question": "Should I teach the draft curriculum?",
          "answerPortableText": [
            {
              "_key": "guidance-faq-2-answer",
              "_type": "block",
              "children": [
                {
                  "_key": "guidance-faq-2-answer-span",
                  "_type": "span",
                  "marks": [],
                  "text": "No. The draft proposals are not statutory. Schools should continue to teach the current national curriculum until the final version takes effect."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ]
        },
        {
          "question": "When will Oak resources change?",
          "answerPortableText": [
            {
              "_key": "guidance-faq-3-answer",
              "_type": "block",
              "children": [
                {
                  "_key": "guidance-faq-3-answer-span",
                  "_type": "span",
                  "marks": [],
                  "text": "We will update our curriculum sequences and resources when the refreshed national curriculum is confirmed, giving schools clear notice and practical support."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ]
        },
        {
          "question": "Will assessment change?",
          "answerPortableText": [
            {
              "_key": "guidance-faq-4-answer",
              "_type": "block",
              "children": [
                {
                  "_key": "guidance-faq-4-answer-span",
                  "_type": "span",
                  "marks": [],
                  "text": "Assessment arrangements will be updated separately by the responsible bodies. We will link to confirmed guidance when it is available."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ]
        },
        {
          "question": "When does this become statutory?",
          "answerPortableText": [
            {
              "_key": "guidance-faq-5-answer",
              "_type": "block",
              "children": [
                {
                  "_key": "guidance-faq-5-answer-span",
                  "_type": "span",
                  "marks": [],
                  "text": "The Department for Education will confirm the statutory timetable. We will keep this page updated with the latest information."
                }
              ],
              "markDefs": [],
              "style": "normal"
            }
          ]
        }
      ]
    }
  ],
